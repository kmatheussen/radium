 static PERTHREAD FFTFLT *ooura_costab;
 static PERTHREAD FFTFLT *ooura_buffer;
 
+    /* Radium: the FFT tables and scratch buffer are preallocated per thread,
+    so that ooura_init() never allocates memory when an FFT object (fiddle~,
+    fft~, ...) is used for the first time from a realtime thread. Pages of
+    the static arrays are only committed by the OS when actually touched.
+    Requests larger than OOURA_MAXN fall back to the heap. */
+#define OOURA_MAXN 65536
+#define OOURA_MAXLOG2 16
+#define OOURA_BITREVSIZE (2 + (1 << (OOURA_MAXLOG2/2)))
+
+static PERTHREAD int ooura_bitrev_static[OOURA_BITREVSIZE];
+static PERTHREAD FFTFLT ooura_costab_static[OOURA_MAXN/2];
+static PERTHREAD FFTFLT ooura_buffer_static[OOURA_MAXN];
+static PERTHREAD int ooura_tables_are_static = 0;
+
 static int ooura_init( int n)
 {
     n = (1 << ilog2(n));
@@ -84,11 +98,29 @@
