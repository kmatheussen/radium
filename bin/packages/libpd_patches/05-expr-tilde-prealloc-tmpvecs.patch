 /*
+ * ex_tmpvecs_free -- free the pool of temporary vectors used by ex_eval.
+ */
+void
+ex_tmpvecs_free(struct expr *expr)
+{
+        if (expr->exp_tmpvecs != NULL)
+        {
+                fts_free(expr->exp_tmpvecs);
+                expr->exp_tmpvecs = NULL;
+        }
+        expr->exp_num_tmpvecs = 0;
+        expr->exp_tmpvecs_index = 0;
+}
+
+/*
+ * ex_tmpvecs_reset -- prepare the temporary vector pool for a new dsp block.
+ */
+void
+ex_tmpvecs_reset(struct expr *expr)
+{
+        expr->exp_tmpvecs_index = 0;
+}
+
+/*
+ * ex_tmpvecs_realloc -- allocate the pool of temporary vectors used by ex_eval.
+ * This is called from expr_dsp(), i.e. before any dsp evaluation, to make sure
+ * ex_eval() never needs to allocate memory while the dsp is running.
+ */
+void
+ex_tmpvecs_realloc(struct expr *expr)
+{
+        size_t size;
+
+        ex_tmpvecs_free(expr);
+
+        if (expr->exp_max_tmpvecs <= 0 || expr->exp_vsize <= 0)
+                return;
+
+        size = (size_t)expr->exp_max_tmpvecs * (size_t)expr->exp_vsize;
+        expr->exp_tmpvecs = (t_float *)fts_malloc(size * sizeof(t_float));
+        if (expr->exp_tmpvecs != NULL)
+                expr->exp_num_tmpvecs = expr->exp_max_tmpvecs;
+
+        expr->exp_tmpvecs_index = 0;
+}
+
+/*
+ * ex_alloc_tmpvec -- get a temporary vector for ex_eval.
+ * Vectors are taken from the preallocated pool. Falls back to fts_malloc
+ * if the pool is too small (or missing).
+ */
+t_float *
+ex_alloc_tmpvec(struct expr *expr)
+{
+        if (expr->exp_tmpvecs != NULL && expr->exp_tmpvecs_index < expr->exp_num_tmpvecs)
+                return expr->exp_tmpvecs + (size_t)(expr->exp_tmpvecs_index++) * (size_t)expr->exp_vsize;
+
+        return (t_float *)fts_malloc(sizeof(t_float) * (size_t)expr->exp_vsize);
+}
+
+/*
+ * ex_free_tmpvec -- free a temporary vector returned by ex_alloc_tmpvec.
+ * Vectors that belong to the preallocated pool are reused and not freed.
+ */
+void
+ex_free_tmpvec(struct expr *expr, t_float *vec)
+{
+        if (expr->exp_tmpvecs != NULL
+            && vec >= expr->exp_tmpvecs
+            && vec < expr->exp_tmpvecs + (size_t)expr->exp_num_tmpvecs * (size_t)expr->exp_vsize)
+                return;
+
+        fts_free(vec);
+}
+
