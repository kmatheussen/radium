+    /* Get a gui update queue entry. Entries are taken from a per-instance
+    preallocated pool to avoid allocating memory when queuing gui updates
+    (which can happen while the host is holding a realtime lock). */
+static t_guiqueue *sys_allocguiqueue(void)
+{
+    t_guiqueue *gq = INTER->i_guifreelist;
+    if (gq != NULL)
+    {
+        INTER->i_guifreelist = gq->gq_next;
+        return gq;
+    }
+    return t_getbytes(sizeof(*gq));
+}
+
+static void sys_freeguiqueue(t_guiqueue *gq)
+{
+    if (gq >= INTER->i_guiqueuepool
+        && gq < INTER->i_guiqueuepool + GUIQUEUE_POOL_SIZE)
+    {
+        gq->gq_next = INTER->i_guifreelist;
+        INTER->i_guifreelist = gq;
+    }
+    else
+        t_freebytes(gq, sizeof(*gq));
+}
