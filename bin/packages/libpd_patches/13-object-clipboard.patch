+    /* Radium: object copy/paste uses a process-global buffer instead of the
+    per-instance copy_binbuf, so that objects can be copied between the
+    different Pd instances hosted by Radium. */
+static char *clipboard_binbuf_text = NULL;
+static int clipboard_binbuf_text_size = 0;
+
+static void clipboard_set_text(const char *buf, int len)
+{
+    char *newbuf = (char *)realloc(clipboard_binbuf_text, len);
+    if (newbuf == NULL)
+        return;
+    clipboard_binbuf_text = newbuf;
+    clipboard_binbuf_text_size = len;
+    memcpy(clipboard_binbuf_text, buf, len);
+}
