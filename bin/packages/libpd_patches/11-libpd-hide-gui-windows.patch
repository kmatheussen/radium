diff -ruN old/pure-data/tcl/pd-gui.tcl new/pure-data/tcl/pd-gui.tcl
--- old/pure-data/tcl/pd-gui.tcl	2026-09-29 19:55:19.653192247 +0200
+++ new/pure-data/tcl/pd-gui.tcl	2026-09-29 19:56:06.661439615 +0200
@@ -802,6 +802,43 @@
 }
 
 # ------------------------------------------------------------------------------
+# libpd / Radium: hide and show all GUI windows without closing or restarting
+# the Tcl/Tk process. Used by libpds2_hide_gui() and libpds2_show_gui() in
+# Radium, and when the user closes a patch window. Windows are only withdrawn,
+# so the same windows (with their position, scroll position and edit state) can
+# be shown again. The console window is hidden by Radium at startup (see
+# RADIUM_PD_GUI_NO_CONSOLE) and stays hidden because its recorded state is
+# "withdrawn".
+
+array set ::libpd_windowstate {}
+set ::libpd_gui_is_shown 1
+
+proc libpd_show_gui {} {
+    foreach x ". [winfo children .]" {
+        if { $x eq [winfo toplevel $x] && [catch {$x cget -tearoff}] } {
+            set state [lindex [array get ::libpd_windowstate $x] 1]
+            if { $state eq "normal" } {
+                wm deiconify $x
+                raise $x
+            }
+        }
+    }
+    set ::libpd_gui_is_shown 1
+}
+
+proc libpd_hide_gui {} {
+    if { $::libpd_gui_is_shown eq 1 } {
+        foreach x ". [winfo children .]" {
+            if { $x eq [winfo toplevel $x] && [catch {$x cget -tearoff}] } {
+                set ::libpd_windowstate($x) [wm state $x]
+                wm withdraw $x
+            }
+        }
+        set ::libpd_gui_is_shown 0
+    }
+}
+
+# ------------------------------------------------------------------------------
 # main
 proc main {argc argv} {
     tk appname pd-gui
