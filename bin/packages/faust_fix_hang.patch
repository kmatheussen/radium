+// Per-thread budget (in box nodes) for boxpp::print. -1 means unlimited.
+// 'boxpp' walks shared (hash-consed) box graphs as trees, which can be
+// exponential, so 'mBox' bounds the traversal instead of only truncating
+// the resulting string.
+static thread_local int gBoxppBudget = -1;
+
+namespace {
+
+struct BoxppBudgetGuard {
+    int fOld;
+    explicit BoxppBudgetGuard(int budget)
+        : fOld(gBoxppBudget)
+    {
+        gBoxppBudget = budget;
+    }
+    ~BoxppBudgetGuard() { gBoxppBudget = fOld; }
+};
 
+}  // namespace
+
 // Limit the box description string to max_size characters
 string mBox(Tree b, int max_size)
 {
+    BoxppBudgetGuard budget(max_size < 0 ? 0 : max_size);
