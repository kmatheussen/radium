         // Fade out the audio in the buffer
         void fadeOut(int count, FAUSTFLOAT** outBuffer)
         {
+            if (count <= 0) {
+                return;
+            }
+    
             // FadeOut on half buffer
             for (int chan = 0; chan < getNumOutputs(); chan++) {
                 double factor = 1., step = 1./double(count);
                 for (int frame = 0; frame < count; frame++) {
                     outBuffer[chan][frame] *= factor;
                     factor -= step;
+                }
+            }
+        }
+    
+        // Fade in the audio in the buffer starting at 'start'
+        void fadeIn(int start, int count, FAUSTFLOAT** outBuffer)
+        {
+            if (count <= 0) {
+                return;
+            }
+    
+            // FadeIn on 'count' frames
+            for (int chan = 0; chan < getNumOutputs(); chan++) {
+                double factor = 0., step = 1./double(count);
+                for (int frame = start; frame < start + count; frame++) {
+                    outBuffer[chan][frame] *= factor;
+                    factor += step;
                 }
             }
         }
