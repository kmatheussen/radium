# Manifest of third-party Pd external libraries built into Radium's
# bin/pd/externals for the Pd2 instrument. See the scripts in this directory:
#
#   check_updated_pd_externals.sh   report upstream versions newer than pinned
#   update_pd_externals.sh          update pinned sources to the newest version
#
# Format: INI-like sections, one per library. Recognized keys:
#
#   tarball    Pinned release tarball in this directory.
#   srcdir     Directory the tarball extracts to (removed before extracting).
#   flags      Options passed to build_pd_external.sh (see its --help).
#   args       Extra arguments forwarded to make/configure/cmake.
#   args_darwin / args_linux / args_windows
#              Extra arguments appended to args on macOS / Linux / Windows.
#              For flags that differ per platform, e.g. ELSE's output file
#              extension or optional dependencies that are not available for
#              a cross target.
#   patches    Space-separated patch files in this directory, applied with
#              'patch -p1' after extraction.
#   exclude    Space-separated paths (relative to the extracted tree) removed
#              before building and when (re)vendoring the tarball.
#   install_dirs  Space-separated subdirectories (e.g. examples) copied next
#              to the installed library.
#   cppflags   Extra preprocessor flags (PD2_CPPFLAGS).
#   cflags     Extra C compiler flags (PD2_CFLAGS).
#   author     Author credit shown in the Help menu's "List of included Pd
#              externals in Pd2" listing (via pd/externals/pd2-externals-
#              credits.txt, generated by build.sh).
#   copyright  Copyright statement shown in the same listing.
#   license    License identifier shown in the same listing.
#   upstream   Repository URL used by git ls-remote for update checks.
#   ref_type   "tag" (default) or "branch".
#   tag_glob   Shell glob filtering which tags are considered (default "*").
#   branch     Branch name for ref_type = branch.
#   ref        Pinned tag name (ref_type = tag) or commit SHA (branch).
#   url        Tarball URL template; %ref% is replaced by the tag/SHA.
#   submodule_*  Same keys for a git submodule whose contents are missing
#              from the upstream archive (mrpeach's slip/): submodule_path,
#              submodule_tarball, submodule_upstream, submodule_ref_type,
#              submodule_tag_glob, submodule_branch, submodule_ref,
#              submodule_url.
#
# The tarball name convention is <section-name>-<ref>.tar.gz, but the value
# here is authoritative.

# --- Networking / OSC -------------------------------------------------------

[osc]
tarball = osc-v0.3.1.tar.gz
srcdir = osc-0.3.1
flags = --install --fix-perthread
args =
patches =
author = Martin Peach
copyright = 2006-2011 Martin Peach
license = GPL-2.0-or-later
upstream = https://github.com/pd-externals/osc
ref_type = tag
tag_glob = v*
ref = v0.3.1
url = https://github.com/pd-externals/osc/archive/refs/tags/%ref%.tar.gz

[iemnet]
tarball = iemnet-v0.3.0.tar.gz
srcdir = iemnet-v0.3.0
flags = --install --compat
args =
patches =
author = IOhannes m zmölnig and others (fork of Martin Peach's net)
copyright = 2010-2020 IOhannes m zmölnig, IEM
license = GPL-2.0
upstream = https://git.iem.at/pd/iemnet
ref_type = tag
tag_glob = v*
ref = v0.3.0
url = https://git.iem.at/pd/iemnet/-/archive/%ref%/iemnet-%ref%.tar.gz

# --- General purpose --------------------------------------------------------

[cyclone]
tarball = cyclone-0.9-5.tar.gz
srcdir = pd-cyclone-0.9-5
flags = --install
args =
patches =
author = Krzysztof Czaja, Hans-Christoph Steiner, Fred Jan Kraan, Alexandre Torres Porres, Derek Kwan, Matt Barber and others
copyright = 2003-2026 Krzysztof Czaja and others
license = BSD-3-Clause
upstream = https://github.com/porres/pd-cyclone
ref_type = tag
tag_glob = [0-9]*
ref = 0.9-5
url = https://github.com/porres/pd-cyclone/archive/refs/tags/%ref%.tar.gz

[zexy]
tarball = zexy-v2.4.4.tar.gz
srcdir = pd-zexy-2.4.4
flags = --install
args =
args_windows = with-regex=no
patches =
author = IOhannes m zmölnig and others
copyright = 1999-2022 IOhannes m zmölnig and others
license = GPL-2.0
upstream = https://github.com/iem-projects/pd-zexy
ref_type = tag
tag_glob = v*
ref = v2.4.4
url = https://github.com/iem-projects/pd-zexy/archive/refs/tags/%ref%.tar.gz

# iemlib's newest release tag (v1.22-3) does not build against Pd >= 0.52
# (COSTABSIZE moved to include/iemlib.h after that tag), so pin the master
# branch instead. The update script follows the branch head.
[iemlib]
tarball = iemlib-edb2890.tar.gz
srcdir = iemlib-edb2890bfdbc664ea41534250cdeaa2ddda9a99d
flags = --install
args =
patches =
author = Thomas Musil, IEM
copyright = 2000-2018 Thomas Musil, IEM
license = LGPL-2.1-or-later
upstream = https://git.iem.at/pd/iemlib
ref_type = branch
branch = master
ref = edb2890bfdbc664ea41534250cdeaa2ddda9a99d
url = https://git.iem.at/pd/iemlib/-/archive/%ref%/iemlib-%ref%.tar.gz

[iemmatrix]
tarball = iemmatrix-v0.6.0.tar.gz
srcdir = pd-iemmatrix-0.6.0
flags = --install
args = with-fftw=no with-gsl=no
args_windows = with-sndfile=no
patches =
author = IOhannes m zmoelnig, Thomas Musil, Franz Zotter
copyright = 2001-2025 IOhannes m zmoelnig, 2004-2006 Thomas Musil, 2005-2025 Franz Zotter
license = GPL-2.0-or-later
upstream = https://github.com/iem-projects/pd-iemmatrix
ref_type = tag
tag_glob = v*
ref = v0.6.0
url = https://github.com/iem-projects/pd-iemmatrix/archive/refs/tags/%ref%.tar.gz

# mrpeach provides [slipenc]/[slipdec], which the osc package's
# packOSCstream.pd / unpackOSCstream.pd abstractions use. Its osc/ sources
# duplicate the separate osc library, so they are disabled by a patch. The
# slip/ directory is a git submodule (empty in the GitHub archive), so it is
# provided by the separately pinned slip-v0.1.tar.gz.
[mrpeach]
tarball = mrpeach-v0.0.20260218.tar.gz
srcdir = mrpeach-0.0.20260218
flags = --install
args =
patches = mrpeach-no-osc.patch
author = Martin Peach
copyright = 2006-2015 Martin Peach
license = GPL-2.0-or-later; net objects GPL-3.0
upstream = https://github.com/pd-externals/mrpeach
ref_type = tag
tag_glob = v*
ref = v0.0.20260218
url = https://github.com/pd-externals/mrpeach/archive/refs/tags/%ref%.tar.gz
submodule_path = slip
submodule_tarball = slip-v0.1.tar.gz
submodule_upstream = https://github.com/pd-externals/slip
submodule_ref_type = tag
submodule_tag_glob = v*
submodule_ref = v0.1
submodule_url = https://github.com/pd-externals/slip/archive/refs/tags/%ref%.tar.gz

# ELSE, reduced the way plugdata builds it: the OpenSSL/ffmpeg-based
# [sfload]/[sfinfo]/[play.file~] objects and [sfz~] are removed (exclude), and
# the Live-Electronics-Tutorial is not bundled. The MIDI-out objects
# ([note.out] etc.) are also removed because they need sys_putmidibyte(),
# which libpd does not export. The CMakeLists/pd.cmake
# changes are in else-radium.patch. The Lua interpreter used by pdlua is
# vendored in ELSE's own source (lua/onelua.c), so no external Lua is needed.
[else]
tarball = else-v.1.0-rc14.tar.gz
srcdir = pd-else-v.1.0-rc14
flags = --install
# ELSE's CMake defaults are ".darwin-fat-32.so" on macOS and ".l_amd64" /
# ".l_arm64" on Linux (deken names). Radium's other externals use
# ".pd_darwin" / ".pd_linux", so set those instead.
args_darwin = -DPD_EXTENSION=.pd_darwin
args_linux = -DPD_EXTENSION=.pd_linux
args_windows = -DPD_EXTENSION=.dll
patches = else-radium.patch else-plaits-s-underscore.patch else-pdlua-lazy-instance.patch else-sfont-symbolic.patch else-midi-own-mifi.patch else-windows.patch
exclude = Source/Audio/sfz~ Source/Shared/ffmpeg Documentation/Live-Electronics-Tutorial Source/Control/sfload.c Source/Control/sfinfo.c Source/Audio/play.file~.c Source/Control/bend.out.c Source/Control/ctl.out.c Source/Control/note.out.c Source/Control/pgm.out.c Source/Control/ptouch.out.c Source/Control/touch.out.c Documentation/Help-files/sfload-help.pd Documentation/Help-files/sfinfo-help.pd Documentation/Help-files/play.file~-help.pd Documentation/Help-files/sfz~-help.pd Documentation/Help-files/bend.out-help.pd Documentation/Help-files/ctl.out-help.pd Documentation/Help-files/note.out-help.pd Documentation/Help-files/pgm.out-help.pd Documentation/Help-files/ptouch.out-help.pd Documentation/Help-files/touch.out-help.pd
author = Alexandre Torres Porres and others
copyright = 2017-2025 Alexandre Torres Porres and others
license = WTFPL-2.0 or as otherwise noted
upstream = https://github.com/porres/pd-else
ref_type = tag
tag_glob = v.*
ref = v.1.0-rc14
url = https://github.com/porres/pd-else/archive/refs/tags/%ref%.tar.gz

# --- Small maintained libraries ---------------------------------------------

# markovChains.c and isoWrap~.c include <sys/math.h>, which is not in the
# macOS SDK; the patch removes it (drand48/seed48 come from stdlib.h and the
# bundled rand48.h shim).
[ekext]
tarball = ekext-v0.3.1.tar.gz
srcdir = ekext-0.3.1
flags = --install
args =
patches = ekext-license-name.patch ekext-no-sys-math-h.patch
author = Ed Kelly
copyright = 2005-2023 Edward Kelly
license = BSD-3-Clause
upstream = https://github.com/pd-externals/ekext
ref_type = tag
tag_glob = v*
ref = v0.3.1
url = https://github.com/pd-externals/ekext/archive/refs/tags/%ref%.tar.gz

[windowing]
tarball = windowing-v0.3.0.tar.gz
srcdir = windowing-0.3.0
