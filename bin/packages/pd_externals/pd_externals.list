copyright = 2002 Joseph A. Sarlo and others
license = GPL-2.0-or-later
upstream = https://github.com/pd-externals/windowing
ref_type = tag
tag_glob = v*
ref = v0.3.0
url = https://github.com/pd-externals/windowing/archive/refs/tags/%ref%.tar.gz

[hcs]
tarball = hcs-v0.2.1.tar.gz
srcdir = hcs-0.2.1
flags = --install --compat
args =
patches =
author = Hans-Christoph Steiner
copyright = 2006-2010 Hans-Christoph Steiner and others
license = GPL-3.0-or-later
upstream = https://github.com/pd-externals/hcs
ref_type = tag
tag_glob = v*
ref = v0.2.1
url = https://github.com/pd-externals/hcs/archive/refs/tags/%ref%.tar.gz

[ggee]
tarball = ggee-v0.28.tar.gz
srcdir = ggee-0.28
flags = --install --compat
args =
patches = ggee-pollfn-decl.patch ggee-drop-unloadable.patch ggee-widgetbehavior-static.patch
exclude = experimental/pvocfreq.c experimental/pvocfreq-help.pd control/rtout.c control/rtout-help.pd
cppflags = -DCOSTABSIZE=512
cflags = -Wno-error=incompatible-pointer-types
author = Guenter Geiger
copyright = Guenter Geiger and others
license = TCL/TK-style
upstream = https://github.com/pd-externals/ggee
ref_type = tag
tag_glob = v*
ref = v0.28
url = https://github.com/pd-externals/ggee/archive/refs/tags/%ref%.tar.gz

# list-abs is abstractions only: its old Makefile template has nothing to
# compile, and build_pd_external.sh's pattern copy installs the .pd files.
[list-abs]
tarball = list-abs-6c703f3aa5ed.tar.gz
srcdir = list-abs-6c703f3aa5ed54014a3dee0c856250928d045d23
flags =
args =
patches =
install_dirs = examples
author = Frank Barknecht
copyright = Frank Barknecht and others
license = BSD-3-Clause
upstream = https://github.com/pd-externals/list-abs
ref_type = branch
branch = master
ref = 6c703f3aa5ed54014a3dee0c856250928d045d23
url = https://github.com/pd-externals/list-abs/archive/%ref%.tar.gz

# The mp3/speex objects are removed by a Makefile patch because they would
# need libmp3lame (LGPL) and libspeex at build and runtime. Everything else
# has no external dependencies. The two files using the removed error() call
# are covered by --compat.
[unauthorized]
tarball = unauthorized-cede002160dc.tar.gz
srcdir = pd-unauthorized-cede002160dc0dbc4c1abaea5e44d23839b8dbd2
flags = --install --compat
args =
patches = unauthorized-no-codecs.patch unauthorized-rtext-compat.patch unauthorized-windows.patch
exclude = src/mp3cast~.c src/mp3fileout~.c src/mp3streamin~.c src/mp3streamout~.c src/mp3write~.c src/speexin~.c src/speexout~.c Documentation/help-files/mp3cast~-help.pd Documentation/help-files/mp3fileout~-help.pd Documentation/help-files/mp3streamin~-help.pd Documentation/help-files/mp3streamout~-help.pd Documentation/help-files/mp3write~-help.pd Documentation/help-files/speexin~-help.pd Documentation/help-files/speexout~-help.pd apple-silicon-binaries
author = Yves Degoyon (PD-extended fork maintained by Alexandre Torres Porres)
copyright = 2002 Yves Degoyon and others
license = GPL-2.0
upstream = https://github.com/porres/pd-unauthorized
ref_type = branch
branch = main
ref = cede002160dc0dbc4c1abaea5e44d23839b8dbd2
url = https://github.com/porres/pd-unauthorized/archive/%ref%.tar.gz
